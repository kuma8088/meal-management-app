# フロントエンドデプロイ設定
# このファイルをコピーして .env.deploy を作成し、環境に合わせて編集してください

# AWS 設定
AWS_REGION=ap-northeast-1

# S3バケット（静的ホスティング用）
S3_BUCKET=meal-management-frontend-${ENVIRONMENT}

# CloudFront Distribution ID（キャッシュ無効化用）
# オプション。設定されていない場合はキャッシュ無効化をスキップします
CLOUDFRONT_DISTRIBUTION_ID=E1234567890ABC

# 環境
ENVIRONMENT=dev
